pipeline {
  agent any

  environment {
    DOCKER_HOST  = "apiadmin@172.188.16.48"        // IP เครื่อง Docker
    DEPLOY_DIR   = "/opt/deploy/DEPLOY-APIFORLAB"  // โฟลเดอร์ปลายทาง
    SERVICE_DIR  = "Customer"
    COMPOSE_FILE = "docker-compose.yaml"
    PROJECT_NAME = "customer"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Sync Customer to Docker Server') {
      steps {
        // 1. แก้ไข ID ให้ตรงกับใน Jenkins ของคุณ (จาก Log คือ docker-server)
        sshagent(['docker-server']) { 
          sh '''
            set -eux

            # 2. เพิ่มคำสั่งสร้างโฟลเดอร์ปลายทางก่อน เพื่อป้องกัน Error 11 (No such file or directory)
            ssh -o StrictHostKeyChecking=no ${DOCKER_HOST} "mkdir -p ${DEPLOY_DIR}/${SERVICE_DIR}"

            # 3. ส่งไฟล์ผ่าน rsync
            rsync -avz --delete -e "ssh -o StrictHostKeyChecking=no" \
              "${SERVICE_DIR}/" "${DOCKER_HOST}:${DEPLOY_DIR}/${SERVICE_DIR}/"

            # 4. สั่ง docker compose บนเครื่อง Docker
            ssh -o StrictHostKeyChecking=no ${DOCKER_HOST} "
              set -eux
              cd '${DEPLOY_DIR}/${SERVICE_DIR}'
              
              # ตรวจสอบว่ามีไฟล์ docker-compose.yaml หรือไม่
              if [ -f '${COMPOSE_FILE}' ]; then
                docker compose -p '${PROJECT_NAME}' -f '${COMPOSE_FILE}' pull || true
                docker compose -p '${PROJECT_NAME}' -f '${COMPOSE_FILE}' up -d
                docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'
              else
                echo 'Error: ${COMPOSE_FILE} not found!'
                exit 1
              fi
            "
          '''
        }
      }
    }
  }
}